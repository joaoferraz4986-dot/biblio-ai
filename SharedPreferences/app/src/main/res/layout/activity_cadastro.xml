<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wallpaper">

    <LinearLayout
        android:id="@+id/generalContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/nav_bar_container"
        android:gravity="center"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/containerCadastro"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <eightbitlab.com.blurview.BlurView
                android:id="@+id/blurViewCadastro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/cadastroContent"
                android:layout_alignBottom="@+id/cadastroContent"
                app:blurOverlayColor="#15FFFFFF">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/login_background" />
            </eightbitlab.com.blurview.BlurView>

            <LinearLayout
                android:id="@+id/cadastroContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textColor="#cdd6f4"
                    android:text="CADASTRO"
                    android:textSize="32sp"
                    android:fontFamily="@font/chicken_pie" />

                <EditText
                    android:id="@+id/edtNomeCadastro"
                    android:textColorHint="#bac2de"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:hint="Nome"
                    android:textColor="#cdd6f4"
                    android:fontFamily="@font/coconut_island" />

                <EditText
                    android:id="@+id/edtEmailCadastro"
                    android:layout_width="match_parent"
                    android:textColorHint="#bac2de"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Email"
                    android:textColor="#cdd6f4"
                    android:fontFamily="@font/coconut_island" />

                <EditText
                    android:id="@+id/edtSenhaCadastro"
                    android:layout_width="match_parent"
                    android:textColorHint="#bac2de"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Senha"
                    android:inputType="textPassword"
                    android:textColor="#cdd6f4"
                    android:fontFamily="@font/coconut_island" />

                <Button
                    android:id="@+id/btnCadastrar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="CRIAR CONTA"
                    android:background="@drawable/button_main_background"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:fontFamily="@font/coconut_island" />

            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nav_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include layout="@layout/nav_bar" />
    </FrameLayout>

</RelativeLayout>
